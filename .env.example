#
# Root .env example for HyperEVM mainnet demo
#

# --- HyperEVM / Hardhat ---
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# Private key for the demo wallet (DO NOT COMMIT REAL KEYS)
PRIVATE_KEY=0xabc123...your_private_key...

# --- LoopGuard Vault ---
# Deployed vault address (HyperEVM)
VAULT_ADDRESS=0xYourVaultAddressHere

# --- Frontend (Next.js) addresses (non-sensitive) ---
NEXT_PUBLIC_LOOP_GUARD_VAULT_ADDRESS=0xYourVaultAddressHere
# Collateral token (e.g., HYPE/WHYPE ERC20 address)
NEXT_PUBLIC_HYPE_ADDRESS=0xCollateralTokenAddress
# USDXL token address
NEXT_PUBLIC_USDXL_ADDRESS=0xca79db4b49f608ef54a5cb813fbed3a6387bc645
NEXT_PUBLIC_POLYMARKET_GUARD_URL=http://localhost:8787

# --- Scripts (optional) ---
# Tiny raw amount to deposit (wei) – default 1e15 (0.001)
SMALL_DEPOSIT_WEI=1000000000000000
# Withdraw explicit shares (raw); if unset, withdraw all
# WITHDRAW_SHARES=0

# --- Polymarket Guard (off-chain) ---
# Set ENABLE_TX=0 to dry-run only
ENABLE_TX=0
# If ENABLE_TX=1, provide an owner key authorized to pauseDeposits()
VAULT_OWNER_PRIVATE_KEY=0xabc123...owner_key...
# Choose a real binary market id
POLYMARKET_MARKET_ID=some-market-id
# Or provide a stable slug instead (preferred)
# Example slug (from URL path after /market/): btc-below-60k-on-dec-31-2025
POLYMARKET_MARKET_SLUG=
# HTTP port for /risk-status
PORT=8787
# Polling interval (sec)
POLL_INTERVAL_SEC=60
# Throttles (sec)
REBALANCE_THROTTLE_SEC=300
PAUSE_THROTTLE_SEC=900
# Risk mapping thresholds
SAFE_MAX=0.4
PANIC_MIN=0.65

HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
VAULT_ADDRESS=0xYourVaultAddress
VAULT_OWNER_PRIVATE_KEY=0xYourOwnerKey
ENABLE_TX=0

# Polymarket
POLYMARKET_MARKET_ID=replace-with-gamma-market-id

# Polling and throttles
POLL_INTERVAL_SEC=60
REBALANCE_THROTTLE_SEC=300
PAUSE_THROTTLE_SEC=900

# HTTP
PORT=8787

# Risk thresholds
SAFE_MAX=0.4
PANIC_MIN=0.65


